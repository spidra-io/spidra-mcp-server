{
  "name": "spidra-mcp",
  "version": "0.8.1",
  "description": "Official Spidra MCP server: web search, scraping, crawling, document parsing, templates and monitors for AI agents",
  "keywords": [
    "spidra",
    "mcp",
    "model context protocol",
    "web scraping",
    "crawling",
    "ai"
  ],
  "homepage": "https://spidra.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/spidra-io/spidra-mcp-server"
  },
  "license": "MIT",
  "author": "Spidra <hello@spidra.io>",
  "type": "module",
  "mcpName": "io.github.spidra-io/spidra-mcp-server",
  "bin": {
    "spidra-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "img"
  ],
  "scripts": {
    "build": "tsup && shx chmod +x dist/index.js",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "dotenv": "^17.2.2",
    "spidra": "^0.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.0.0",
    "playwright": "1.57.0",
    "shx": "^0.3.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
